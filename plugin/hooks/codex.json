{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "INTENT_HOST=codex python3 \"${PLUGIN_ROOT}/hooks/static-dispatch.py\"",
            "statusMessage": "Checking git intent"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/track-tokens.py\" codex",
            "statusMessage": "Tracking tokens"
          }
        ]
      }
    ]
  }
}
